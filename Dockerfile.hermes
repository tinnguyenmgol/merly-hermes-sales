FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/merly HERMES_HOME=/data/hermes-sales API_SERVER_ENABLED=true API_SERVER_HOST=0.0.0.0 API_SERVER_PORT=8643 MERLY_MCP_SCRIPT=/app/merly-adapter/mcp_server.py HERMES_SALES_ATTESTATION=/data/sales-audit/inventory.json
WORKDIR /app/merly-adapter
COPY HERMES-SOURCE.json fetch_hermes.py ./
COPY build-sources/ ./build-sources/
RUN pip install --no-cache-dir uv==0.13.1 && python fetch_hermes.py && uv pip install --system -e '/opt/hermes-src/hermes-agent-848fc0ad8be766b9dc10fe42bd80b5fc2d45d95c[mcp,web]' aiohttp==3.14.3 gunicorn==26.2.0
COPY stock_probe.py haravan_variants.py stock_options.py stock_report.py merly_tools.py mcp_server.py tool-schema.json catalog-enrichment.json ./
COPY explicit_stock.py stock_scope_memory.py direct_stock.py sales_gateway.py hermes_client.py state.py safety.py audit_instance.py run_sales.py SYSTEM-PROMPT.md hermes-config.template.json ./
COPY vendor/ ./vendor/
COPY pilot-web/ ./pilot-web/
RUN mkdir -p /home/merly /data/hermes-sales /data/sales-audit /data/pilot-gateway && chown -R 10001:10001 /home/merly /data
USER 10001:10001
EXPOSE 8643
ENTRYPOINT ["python","run_sales.py"]
