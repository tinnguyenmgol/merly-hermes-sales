FROM python:3.12-slim
WORKDIR /app/learning
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY learning-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY learning_contract.py learning-service/learning_store.py learning-service/learning_server.py learning-service/learning_cli.py learning-service/recipes.py ./
RUN mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8090
CMD ["gunicorn","--no-control-socket","--bind","0.0.0.0:8090","--workers","1","--threads","2","--timeout","10","--keep-alive","2","learning_server:create_application()"]
