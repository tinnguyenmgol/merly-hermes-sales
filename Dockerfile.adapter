FROM python:3.12-slim
WORKDIR /app/merly-adapter
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY product_discovery.py haravan_variants.py stock_options.py stock_report.py merly_tools.py mcp_server.py tool-schema.json catalog-enrichment.json ./
COPY conversation.py fast_limits.py fast_replies.py public_chat.py explicit_stock.py stock_scope_memory.py direct_stock.py sales_gateway.py hermes_client.py state.py safety.py SYSTEM-PROMPT.md ./
COPY vendor/ ./vendor/
COPY public-web/ ./public-web/
RUN mkdir -p /app/pilot-data && chown 10001:10001 /app/pilot-data
USER 10001:10001
EXPOSE 8080
CMD ["gunicorn","--no-control-socket","--bind","0.0.0.0:8080","--workers","1","--threads","4","--timeout","60","sales_gateway:application"]
