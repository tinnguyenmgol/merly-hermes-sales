# Pilot gateway secrets only. Never use owner/default API key.
PILOT_ACCESS_KEY=
PILOT_SESSION_SECRET=
HERMES_PILOT_STATE_DB=/app/pilot-data/hermes-sessions.sqlite3
HERMES_SALES_API_BASE=
HERMES_SALES_API_KEY=
HERMES_SALES_MODEL_ALIAS=
HERMES_SALES_ISOLATION_APPROVED=0
HERMES_CUSTOMER_DATA_APPROVED=0
HERMES_MODEL_COST_APPROVED=0
HERMES_ALLOW_HTTP=0
HERMES_SALES_ATTESTATION=/app/sales-audit/inventory.json

# Sales backend only; do not send values in chat. Leave model blank until configured.
GEMINI_API_KEY=
MERLY_GEMINI_MODEL=

# Fast routes do not consume paid AI budget; no transport retries.
MERLY_AI_PER_MINUTE=6
MERLY_AI_PER_DAY=100
MERLY_PUBLIC_PER_MINUTE=120
MERLY_VISITOR_PER_MINUTE=12
MERLY_STOCK_PER_MINUTE=30
MERLY_AI_CONCURRENT=2
MERLY_STOCK_CONCURRENT=1

# One bounded same-turn correction, charged to the existing AI budget.
MERLY_AGENT_REPAIR_ENABLED=1
